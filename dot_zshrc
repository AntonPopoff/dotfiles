# Enter tmux session during startup 
# NO_TMUX=1 - skip tmux autostart
if [[ -z "$TMUX" && -o interactive && -z "$NO_TMUX" ]] && command -v tmux &> /dev/null; then
    exec tmux new-session -A -s main
fi

# Allow `# comments` on the command line
setopt INTERACTIVE_COMMENTS

# Setup zsh history files and size
HISTFILE="$HOME/.zsh_history"
HISTSIZE=128000
SAVEHIST=128000
setopt SHARE_HISTORY        # Share zsh history across all sessions
setopt HIST_IGNORE_ALL_DUPS # Delete old recorded entry if new entry is a duplicate
setopt HIST_IGNORE_SPACE    # Don't record entries starting with a space
setopt HIST_REDUCE_BLANKS   # Prevent irrelevant whitespace from being added to the history
setopt EXTENDED_HISTORY     # Store when each command ran and how long it took
setopt HIST_VERIFY          # History expansion (!!, !$, !cmd) is put back on the prompt first instead of being executed immediately

# Ctrl+X, then Ctrl+E: open the current command line in $EDITOR (nvim)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Mark $PATH array as unique to prevent nested shells from appending duplicates
typeset -U path

# If .local directory exists add it to the path
if [[ -d "$HOME/.local/bin" ]]; then
    # Prepend the directory so the .local binaries can take precedence
    path=("$HOME/.local/bin" $path)
fi

# If Android SDK directory exists add it to the path
if [[ -d "$HOME/Android/Sdk" ]]; then
    export ANDROID_HOME="$HOME/Android/Sdk"
    path+=("$ANDROID_HOME/platform-tools" "$ANDROID_HOME/emulator")
fi

# Use emacs keymaps by default
bindkey -e

# Use Neovim as default editor if installed
if command -v nvim &> /dev/null; then
    export EDITOR=nvim
    export VISUAL=nvim
fi

# Load and enable zsh autocompletion module
autoload -Uz compinit && compinit

# Improve autocomplete menu
zstyle ':completion:*' menu select                  # Make the menu navigable with arrow keys
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' # Case-insensitive completion

# Load vcs_info built-in module for reading git state for the prompt
autoload -Uz vcs_info

# Append vsc_info pre-prompt hook
autoload -Uz add-zsh-hook
add-zsh-hook precmd vcs_info

zstyle ':vcs_info:*' enable git                   # Enable git repo checking
zstyle ':vcs_info:git:*' formats '%F{34}%s:%b%f ' # Output branch name only

# Use 'actionformats' instead 'formats' to show current action while in the middle of something (merge, rebase, bisect)
zstyle ':vcs_info:git:*' actionformats '%F{34}%s:%b%f %F{red}(%a)%f '

# Array containing current shell context information
typeset -a ctx=()

# Check for an active SSH shell
if [[ -n "$SSH_CONNECTION" || -n "$SSH_TTY" ]]; then
    ctx+=('%F{yellow}ssh:%n@%m%f')
fi

# Check for an isolated shells like docker or podman containers
if [[ -n "$CONTAINER_ID" ]]; then
    ctx+=("%F{magenta}ctr:${CONTAINER_ID}%f")
elif [[ -f /run/.toolboxenv ]]; then
    ctx+=('%F{magenta}ctr:toolbox%f')
elif [[ -f /run/.containerenv ]]; then
    ctx+=('%F{magenta}ctr:podman%f')
elif [[ -f /.dockerenv ]]; then
    ctx+=('%F{magenta}ctr:docker%f')
elif [[ -n "$container" ]]; then
    ctx+=("%F{magenta}ctr:${container}%f")
fi

# Check for temporary sub-shells like "chezmoi cd"
if [[ -n "$CHEZMOI" ]]; then
    ctx+=('%F{cyan}chezmoi%f')
fi

# Check for a custom zsh configuration
if [[ -n "$ZDOTDIR" && "$ZDOTDIR" != "$HOME" ]]; then
    ctx+=("%F{cyan}zdot:${ZDOTDIR:t}%f")
fi

# Join context values to string and separate by space character
PROMPT_CONTEXT="${(j: :)ctx}"

if [[ -n "$PROMPT_CONTEXT" ]]; then
    PROMPT_CONTEXT+=' '
fi

unset ctx

# Enable zsh custom prompt
setopt PROMPT_SUBST

# Set custom prompt with current context info, git repo status and vibrant colors
PROMPT='${PROMPT_CONTEXT}%B%F{blue}%~%f ${vcs_info_msg_0_}%(!.%F{red}#%f.>)%b '

# Improve less command default behavior
# -i: Smart case search
# -M: Detailed prompt at the bottom
# -R: Output RAW control characters (REQUIRED for colors)
# -F: Quit automatically if content fits on one screen
# -X: Keep content on screen after exiting
# -x4: Set tab width to 4 spaces
export LESS="-i -M -R -F -X -x4"

# Enable zoxide if installed and replace cd command with it
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh --cmd cd)"
fi

# Setup eza if installed
if command -v eza &> /dev/null; then
    # --long - use long format by default
    # --all - show hidden dot files
    # --git - additionally show git status if inside a git's repo
    # --group-directories-first - group directories and files together and show directories at the top
    alias ls='eza --long --all --git --group-directories-first'
    # Show file tree up to 3 levels deep
    alias lt='eza --tree --level=3 --git-ignore'
fi

# Setup btop's alias
if command -v btop &> /dev/null; then
    alias top='btop'
fi

# Setup nvim's alias
if command -v nvim &> /dev/null; then
    alias vi='nvim'
    alias vim='nvim'
fi

# If ripgrep is installed supply a config file
if command -v rg &> /dev/null; then
    export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
fi

# Setup bat's alias and default values
if command -v bat &> /dev/null; then
    # Setup bat's default format and color scheme
    export BAT_STYLE='plain'
    export BAT_THEME='ansi'

    # Setup bat as the default input processor for less
    export LESSOPEN="| bat --color=always --style=plain %s"

    # Use bat to output colored man pages
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"

    alias cat='bat'
fi

# Fzf setup and custom commands
if command -v fzf &> /dev/null; then
    source <(fzf --zsh)

    # Setting fd as the default file walker for fzf
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --strip-cwd-prefix'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    # Setting fd as the default directories walker for fzf
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git --strip-cwd-prefix'

    # Use fd for generating path candidates for the ** trigger
    _fzf_compgen_path() {
        fd --hidden --exclude .git . "$1"
    }

    # Use fd for generating directory candidates for the ** trigger
    _fzf_compgen_dir() {
        fd --type d --hidden --exclude .git . "$1"
    }

    if [[ -f "$HOME/.zsh/fzf-git.sh/fzf-git.sh" ]]; then
        source "$HOME/.zsh/fzf-git.sh/fzf-git.sh"

        # Remap fzf git branches command so it won't clash with tmux
        bindkey '^Gb' fzf-git-branches-widget  # Ctrl-g + b

        # Define cat command for preview window
        if command -v bat &> /dev/null; then
            FZF_GIT_CAT='bat --color=always'
        fi
    fi
fi

