" IdeaVim config start!

" Map Leader key to Space (must come before any <Leader> mappings)
let mapleader = " "

" Options
syntax on           " Enable syntax highlighting
set ruler           " Show the cursor position all the time
set wildmenu        " Display completion matches in a status line
set laststatus=2    " Always display the status line
set encoding=utf-8  " Use UTF-8 encoding
set cursorline      " Highlight the current line
set number          " Show line numbers
set relativenumber  " Make line numbers relative
set scrolloff=5     " Keep at least 5 lines above and below the cursor
set showcmd         " Display incomplete commands
set history=200     " Keep 200 lines of command line history
set ignorecase      " Make search case insensitive
set smartcase       " Make search case sensitive if the pattern contains any uppercase letter
set incsearch       " Show matches while typing the search pattern
set hlsearch        " Highlight search results

" Tab and indentation options
set expandtab       " Use spaces instead of tab characters
set softtabstop=4   " Insert 4 spaces when Tab is pressed
set shiftwidth=4    " Use 4 spaces for indentation

" Vim bindings
nnoremap <Space> <Nop>
nmap <C-c> <Action>(EditorEscape)

" Disable arrow keys
noremap <Left> <Nop>
noremap <Right> <Nop>
noremap <Up> <Nop>
noremap <Down> <Nop>

" Clear search highlighting (mirrors Neovim's default <C-l>)
nnoremap <silent> <C-l> :nohlsearch<CR>

" Clipboard and yank register mappings
nnoremap <Leader>yy "+yy
nnoremap <Leader>y "+y
xnoremap <Leader>y "+y
nnoremap <Leader>p "+p
xnoremap <Leader>p "+p
nnoremap <Leader>P "+P
xnoremap <Leader>P "_dP

" Split panes mappings
nmap <Leader>wv <Action>(SplitVertically)
nmap <Leader>wh <Action>(SplitHorizontally)
nnoremap <Leader>j <C-w>j
nnoremap <Leader>k <C-w>k
nnoremap <Leader>h <C-w>h
nnoremap <Leader>l <C-w>l

" Place cursor at the center of the screen while scrolling
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap <C-f> <C-f>zz
nnoremap <C-b> <C-b>zz

" Place search result at the center of the screen
nnoremap n nzz
nnoremap N Nzz

" Search actions
nmap <Leader>ff <Action>(SearchEverywhere)
nmap <Leader>fg <Action>(FindInPath)
nmap <Leader>fr <Action>(FindUsages)

" Code actions
nmap <Leader>rn <Action>(RenameElement)
nmap <Leader>fc <Action>(ShowReformatFileDialog)
xmap <Leader>fc <Action>(ShowReformatFileDialog)

" Run and debug actions
nmap <F5> <Action>(Debug)
nmap <S-F5> <Action>(Stop)
nmap <F6> <Action>(Resume)

" Breakpoint actions
nmap <Leader>b <Action>(ToggleLineBreakpoint)
nmap <Leader>c <Action>(AddConditionalBreakpoint)
